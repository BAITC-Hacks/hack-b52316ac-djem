# Server-side OpenAI API key. Never use a ChatGPT web-session token here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AGENT_MODEL=gpt-4.1-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=40
AGENT_MAX_STEPS=8
# Generate two distinct random tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
AGENT_API_TOKEN=
DATABASE_PATH=data/akim.sqlite3
HOST=127.0.0.1
PORT=8000
# Comma-separated hostname allowlist; set actual public hostname for deployment.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Display scale for the FIRST database initialization; dataset remains editable later.
TENGE_PER_UNIT=100000000
LOG_LEVEL=info

# Initial administrator password; applied only when the admin account is first created.
INITIAL_ADMIN_PASSWORD=admin
